# === PNPM Supply Chain & Security Hardening ===

# 1. Block exotic transitive dependencies (prevents sub-deps pointing to arbitrary Git URLs or raw tarballs)
block-exotic-subdeps=true

# 2. Package Quarantine / Cooldown Window (in minutes, 2880 = 48 hours)
# Prevents installing brand-new package releases before npm security/community can detect malware
minimum-release-age=2880

# 3. Always verify local store integrity against remote package checksums
verify-store-integrity=true

# 4. Strict engine checks to prevent incompatible or unvetted environments
engine-strict=true

# 5. Prevent silent dependency drift in CI / production
frozen-lockfile=false
