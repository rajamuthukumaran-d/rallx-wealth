{
  "name": "@rallx-wealth/workspace",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "start": "pnpm --filter @rallx-wealth/mobile start",
    "ios": "pnpm --filter @rallx-wealth/mobile ios",
    "android": "pnpm --filter @rallx-wealth/mobile android",
    "web": "pnpm --filter @rallx-wealth/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.6.0"
  }
}
